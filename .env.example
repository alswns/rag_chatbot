# RAG System Configuration
# 2024 Advanced Features

# ==================== Model Configuration ====================
LLM_MODEL_ID=deepseek-r1
LLM_BACKEND=vllm
VLLM_API_URL=http://localhost:8000/v1
OLLAMA_API_URL=http://localhost:11434

# ==================== Database Configuration ====================
CHROMA_HOST=localhost
CHROMA_PORT=8000
GRAPH_PERSIST_PATH=./data/graph.pkl

# ==================== Search Configuration ====================
SEARCH_TOP_K=10
ENABLE_RERANKING=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=50

# ==================== Intelligent Retrieval ====================
# Query Expansion: 단일 쿼리를 3가지 버전으로 확장
ENABLE_QUERY_EXPANSION=true

# Multi-path Drill-down: 상위 N개 허브를 병렬 탐색
ENABLE_MULTI_PATH=true
MULTI_PATH_HUB_K=3
HUB_SCORE_THRESHOLD=0.3

# Result Fusion: RRF (Reciprocal Rank Fusion) 또는 Score Sum
FUSION_METHOD=rrf

# ==================== Web Search ====================
# 웹 검색 활성화 (RAG 결과 보완용)
ENABLE_WEB_SEARCH=true

# 웹 검색용 Query Expansion (Original, Conceptual, Practical)
ENABLE_WEB_QUERY_EXPANSION=true
WEB_SEARCH_TIMEOUT=10
WEB_SEARCH_MAX_RESULTS=5

# ==================== Intelligent Chunking ====================
# 메타데이터 기반 청킹 (Temporal, Entities, Keywords)
ENABLE_INTELLIGENT_CHUNKING=true
CHUNK_SIZE=900
CHUNK_OVERLAP=200

# ==================== Token Management ====================
MAX_MODEL_LEN=8192
RESERVED_OUTPUT_TOKENS=1024

# ==================== Server Configuration ====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8010
LOG_LEVEL=INFO
THREAD_POOL_SIZE=4

# ==================== Notion Integration ====================
NOTION_TOKEN=<your-notion-token>
NOTION_DATABASE_ID=<optional-database-id>

# ==================== Embedding Configuration ====================
EMBEDDING_MODEL=BAAI/bge-m3
